Description: Fix GTM thread binding for servers with fewer cores
 OpenTenBase GTM hardcoded thread binding assumes servers have >= 22 cores.
 On servers with fewer cores (e.g., 2-core VPS), bind_service_threads() creates
 an empty CPU set (for(cpu=2; cpu<2) never runs), causing pthread_setaffinity_np
 to return EINVAL (22) and GTM startup fails with "binding threads failed for 22".
 .
 This patch:
 1. Makes bind_service_threads() skip binding when cpu_num <= 2 (no CPUs available
    after excluding CPU 0 for OSS and CPU 1 for timekeeper)
 2. Downgrades bind_thread_to_cores error from ERROR to WARNING - CPU binding is
    an optimization, not a critical requirement for GTM operation.
 .
 Tested on 2-core server - GTM now starts successfully without aborting.
Author: OpenTenBase Packaging <packaging@opentenbase.org>
Forwarded: not-needed
Last-Update: 2026-07-03

--- a/src/gtm/main/main.c
+++ b/src/gtm/main/main.c
@@ -2213,7 +2213,8 @@ void bind_thread_to_cores (cpu_set_t cpuset)

    if((r = pthread_setaffinity_np(current_thread, sizeof(cpu_set_t), &cpuset)))
    {
-		elog(ERROR, "binding threads failed for %d", r);
+		elog(WARNING, "CPU affinity binding failed (error %d), continuing without binding", r);
+		elog(LOG, "GTM will function normally but may have reduced performance");
    }
 }

@@ -2236,6 +2237,13 @@ void bind_timekeeper_thread(void)
 void bind_service_threads(void)
 {
 	int cpu_num = get_nprocs();
+
+	/* If server has <= 2 cores, skip binding */
+	if (cpu_num <= 2)
+	{
+		elog(LOG, "Server has %d cores, skipping service thread CPU binding", cpu_num);
+		return;
+	}
 	int cpu;
 	cpu_set_t cpuset;