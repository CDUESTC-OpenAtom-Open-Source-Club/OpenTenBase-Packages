# OpenTenBase Runtime Image — Debian 12 (直装版)
# 通过 APT 仓库直接安装成品包。
#
# 构建:
#   docker build -f docker/runtime/Dockerfile.debian-12 -t opentenbase:5.0-debian12 .
# 多架构:
#   docker buildx build --platform linux/amd64,linux/arm64 -f docker/runtime/Dockerfile.debian-12 -t opentenbase:5.0-debian12 .

FROM debian:bookworm

ARG OTB_VERSION=5.0
ENV DEBIAN_FRONTEND=noninteractive

# GTM 线程绑定 workaround（CDN 包尚未包含 PR #69 修复）
RUN if [ "$(nproc)" -le 2 ]; then \
        apt-get install -y gcc && \
        echo 'int pthread_setaffinity_np(void* t, long s, const void* c) { return 0; }' > /tmp/noaffinity.c && \
        gcc -shared -fPIC -o /usr/lib/opentenbase/noaffinity.so /tmp/noaffinity.c && \
        rm -f /tmp/noaffinity.c && \
        apt-get remove -y gcc; \
    fi
ENV LD_PRELOAD=/usr/lib/opentenbase/noaffinity.so

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        libatomic1 \
        libxml2 \
        sudo \
        iputils-ping \
        net-tools \
        hostname \
        util-linux \
        procps \
    && rm -rf /var/lib/apt/lists/*

# 配置 OpenTenBase APT 仓库（Debian 12 codename = bookworm）
RUN curl -fsSL https://raw.githubusercontent.com/CDUESTC-OpenAtom-Open-Source-Club/OpenTenBase-Packages/main/scripts/setup-apt.sh | bash

RUN apt-get update \
    && apt-get install -y --no-install-recommends opentenbase \
    && rm -rf /var/lib/apt/lists/*

RUN id opentenbase 2>/dev/null || useradd -m -s /bin/bash opentenbase \
    && mkdir -p /var/lib/opentenbase/data \
    && chown -R opentenbase:opentenbase /var/lib/opentenbase

ENV PATH="/usr/lib/opentenbase/${OTB_VERSION}/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/lib/opentenbase/${OTB_VERSION}/lib"

COPY docker/runtime/entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh

WORKDIR /home/opentenbase

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD pg_isready -h localhost -p 5432 || exit 1

ENTRYPOINT ["/entrypoint.sh"]
