# OpenTenBase Runtime Image — openEuler 22.03 (直装版)
# 通过 DNF 仓库直接安装成品包。适合国产化/ARM 场景。
#
# 构建:
#   docker build -f docker/runtime/Dockerfile.openeuler-22.03 -t opentenbase:5.0-openeuler22.03 .
# 多架构:
#   docker buildx build --platform linux/amd64,linux/arm64 -f docker/runtime/Dockerfile.openeuler-22.03 -t opentenbase:5.0-openeuler22.03 .

FROM openeuler/openeuler:22.03

ARG OTB_VERSION=5.0

# GTM 线程绑定 workaround（CDN 包尚未包含 PR #69 修复）
RUN if [ "$(nproc)" -le 2 ]; then \
        dnf install -y gcc && \
        echo 'int pthread_setaffinity_np(void* t, long s, const void* c) { return 0; }' > /tmp/noaffinity.c && \
        gcc -shared -fPIC -o /usr/lib/opentenbase/noaffinity.so /tmp/noaffinity.c && \
        rm -f /tmp/noaffinity.c && \
        dnf remove -y gcc; \
    fi
ENV LD_PRELOAD=/usr/lib/opentenbase/noaffinity.so

# openEuler 22.03 基础镜像已含 openssl-libs(1.1)、glibc、libxml2、libcurl
RUN dnf install -y --allowerasing \
        curl \
        libssh \
        libatomic \
        sudo \
        iputils \
        net-tools \
        nmap-ncat \
        hostname \
        util-linux-user \
        procps-ng \
    && dnf clean all

# 配置 OpenTenBase DNF 仓库
RUN curl -fsSL https://raw.githubusercontent.com/CDUESTC-OpenAtom-Open-Source-Club/OpenTenBase-Packages/main/scripts/setup-rpm.sh | bash

# 安装 OpenTenBase
RUN dnf install -y opentenbase-${OTB_VERSION} && dnf clean all

# 创建运行用户
RUN id opentenbase 2>/dev/null || useradd -m -s /bin/bash opentenbase \
    && mkdir -p /var/lib/opentenbase/data \
    && chown -R opentenbase:opentenbase /var/lib/opentenbase

ENV PATH="/usr/lib/opentenbase/${OTB_VERSION}/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/lib/opentenbase/${OTB_VERSION}/lib"

# 集群入口
COPY docker/runtime/entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh

WORKDIR /home/opentenbase

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD pg_isready -h localhost -p 5432 || exit 1

ENTRYPOINT ["/entrypoint.sh"]
