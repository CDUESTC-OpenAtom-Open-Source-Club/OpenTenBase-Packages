# OpenTenBase Runtime Image — Ubuntu 24.04 (直装版)
# 通过 APT 仓库直接安装成品包，构建快、镜像小。
# 适用：单节点体验、多节点 Compose 集群部署。
#
# 构建:
#   docker build -f docker/runtime/Dockerfile.ubuntu-24.04 -t opentenbase:5.0-ubuntu24.04 .
# 多架构:
#   docker buildx build --platform linux/amd64,linux/arm64 -f docker/runtime/Dockerfile.ubuntu-24.04 -t opentenbase:5.0-ubuntu24.04 .

FROM ubuntu:24.04

ARG OTB_VERSION=5.0
ENV DEBIAN_FRONTEND=noninteractive

# 运行时依赖（libatomic1 供 GTM/原子操作使用）
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        libatomic1 \
        libxml2 \
        sudo \
        iputils-ping \
        net-tools \
        hostname \
        util-linux \
        procps \
    && rm -rf /var/lib/apt/lists/*

# 配置 OpenTenBase APT 仓库（含 GPG 校验 + 镜像自动选择）
RUN curl -fsSL https://raw.githubusercontent.com/CDUESTC-OpenAtom-Open-Source-Club/OpenTenBase-Packages/main/scripts/setup-apt.sh | bash

# 安装 OpenTenBase（meta 包 = server + client + contrib）
RUN apt-get update \
    && apt-get install -y --no-install-recommends opentenbase \
    && rm -rf /var/lib/apt/lists/*

# 创建运行用户（包未创建则手动创建）
RUN id opentenbase 2>/dev/null || useradd -m -s /bin/bash opentenbase \
    && mkdir -p /var/lib/opentenbase/data \
    && chown -R opentenbase:opentenbase /var/lib/opentenbase

ENV PATH="/usr/lib/opentenbase/${OTB_VERSION}/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/lib/opentenbase/${OTB_VERSION}/lib"

# 集群入口（支持 NODE_TYPE=gtm|coordinator|datanode）
COPY docker/runtime/entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh

WORKDIR /home/opentenbase

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD pg_isready -h localhost -p 5432 || exit 1

ENTRYPOINT ["/entrypoint.sh"]
