# OpenTenBase Runtime Image — Fedora 40 (直装版)
# 通过 DNF 仓库直接安装成品包。
#
# 构建:
#   docker build -f docker/runtime/Dockerfile.fedora-40 -t opentenbase:5.0-fedora40 .
# 多架构:
#   docker buildx build --platform linux/amd64,linux/arm64 -f docker/runtime/Dockerfile.fedora-40 -t opentenbase:5.0-fedora40 .

FROM quay.io/fedora/fedora:40

ARG OTB_VERSION=5.0

# 运行时依赖（Fedora 40 has libssh2 in default repos）
RUN dnf install -y --allowerasing \
        curl \
        gnupg2 \
        libatomic \
        libpq \
        libssh2 \
        sudo \
        iputils \
        net-tools \
        hostname \
        util-linux \
        procps-ng \
    && dnf clean all

# 配置 OpenTenBase DNF 仓库
RUN ARCH=$(uname -m) && \
    curl -fsSL https://repo.blackevil217.com/rpm/gpg-key.asc -o /tmp/gpg-key.asc && \
    rpm --import /tmp/gpg-key.asc && rm -f /tmp/gpg-key.asc && \
    printf '[opentenbase]\nname=OpenTenBase Packages\nbaseurl=https://repo.blackevil217.com/rpm/fc40/%s\nenabled=1\ngpgcheck=1\ngpgkey=https://repo.blackevil217.com/rpm/gpg-key.asc\n' "$ARCH" > /etc/yum.repos.d/opentenbase.repo && \
    chmod 644 /etc/yum.repos.d/opentenbase.repo

# 安装 OpenTenBase
RUN dnf makecache && \
    dnf install -y opentenbase-${OTB_VERSION} || \
    dnf install -y opentenbase-server-${OTB_VERSION} opentenbase-client-${OTB_VERSION} opentenbase-contrib-${OTB_VERSION} \
    && dnf clean all

# 创建运行用户
RUN id opentenbase 2>/dev/null || useradd -m -s /bin/bash opentenbase \
    && mkdir -p /var/lib/opentenbase/data \
    && chown -R opentenbase:opentenbase /var/lib/opentenbase

ENV PATH="/usr/lib/opentenbase/${OTB_VERSION}/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/lib/opentenbase/${OTB_VERSION}/lib"

COPY docker/runtime/entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh

WORKDIR /home/opentenbase

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD pg_isready -h localhost -p 5432 || exit 1

ENTRYPOINT ["/entrypoint.sh"]